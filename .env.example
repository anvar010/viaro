# Backend API (viaro-backend). Start it with `npm run dev` in that project.
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# The customer site. The portal links back to it for the marketing pages, and in
# production these are two deploys of two projects on two hosts:
#   viaro.com        → viaro-frontend
#   drive.viaro.com  → viaro-driver   (this project)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maps — 'none' renders a static placeholder panel so the trip screens still build.
# The provider decision is still open (FRONTEND-STATUS §5.2).
NEXT_PUBLIC_MAP_PROVIDER=none
NEXT_PUBLIC_MAP_API_KEY=
