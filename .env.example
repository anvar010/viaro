NODE_ENV=development
PORT=5000

MONGO_URI=
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

APP_TIMEZONE=America/Los_Angeles
CORS_ORIGIN=*

# Rate limits. These defaults are the production posture — raise AUTH_RATE_LIMIT_MAX
# locally if you run the Postman collection repeatedly (it logs in ~15 times per run).
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15

# ---------------------------------------------------------------------------
# Flight data — aviationstack | flightaware
# Leave the provider blank to use mock flight data (the app still runs).
#   aviationstack: FLIGHT_API_KEY = your access_key
#   flightaware:   FLIGHT_API_KEY = your AeroAPI x-apikey
# ---------------------------------------------------------------------------
FLIGHT_API_PROVIDER=
FLIGHT_API_KEY=

# ---------------------------------------------------------------------------
# Payment gateway — stripe
# Leave the provider blank for mock charges (no money moves).
#   PAYMENT_GATEWAY_SECRET_KEY     = sk_live_... / sk_test_...
#   PAYMENT_GATEWAY_WEBHOOK_SECRET = whsec_...  (Stripe Dashboard -> Webhooks)
#   Point the webhook endpoint at  POST /payments/webhook
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMS / push — twilio | firebase | expo
# Leave the provider blank to only log what would have been sent.
#   twilio:   SMS_PUSH_API_KEY = auth token, plus the two TWILIO_* keys
#   firebase: SMS_PUSH_API_KEY or FCM_ACCESS_TOKEN = OAuth token, plus FCM_PROJECT_ID
#   expo:     SMS_PUSH_API_KEY = Expo access token
# ---------------------------------------------------------------------------
SMS_PUSH_PROVIDER=
SMS_PUSH_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Transactional email — password-reset links. Provider: resend
# Leave EMAIL_PROVIDER blank to only log what would have been sent (local only:
# the log line is redacted in production, since a reset link is an account takeover).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Public URL of the customer web app.
# Password-reset links are built from this — leave it at the localhost default in a
# deployment and every reset email you send will point at the recipient's own machine.
# ---------------------------------------------------------------------------
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Driver document storage (licence / insurance)
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Money rules
#
# 1. The customer's fare is split between the company and the admin/platform.
#    These two MUST total 100 or the app refuses to start.
# 2. The driver is then paid BY WHOEVER OWNS THEM, OUT OF THAT OWNER'S SHARE:
#    a company pays its roster drivers, the admin pays platform drivers.
#    Per-driver rates are set via PATCH /admin/drivers/:id — these are the
#    defaults used until an owner sets one.
#      percentage -> % of the owner's share for that trip
#      flat       -> fixed amount per trip
# ---------------------------------------------------------------------------
COMPANY_REVENUE_PCT=60
ADMIN_REVENUE_PCT=40
DRIVER_PAYOUT_MODE=percentage
DRIVER_PAYOUT_VALUE=70

# Spec §8 rule 3 — withdrawals ONLY. Never applied to refunds or ride credit.
WITHDRAWAL_FEE_PCT=10
